      "name": "TC02 - Device status",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Tank level is valid\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.level_percent).to.be.within(0, 100);\r",
              "});\r",
              "\r",
              "pm.test(\"Pump state is valid\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect([\"on\", \"off\"]).to.include(data.pump_state);\r",
              "});\r",
              "\r",
              "pm.test(\"Last seen is present\", function () {\r",
              "    const data = pm.response.json();\r",
              "    pm.expect(data.last_seen).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
